{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Aggregator": {
    "ForwardHeaders": [ "Authorization", "X-Correlation-Id", "X-Tenant-Id", "Accept-Language" ],
    "Services": {
      "ServiceA": { "BaseUrl": "http://localhost:5100/service-a/", "TimeoutSeconds": 5 },
      "ServiceB": { "BaseUrl": "http://localhost:5100/service-b/", "TimeoutSeconds": 5 },
      "ServiceC": { "BaseUrl": "http://localhost:5100/service-c/", "TimeoutSeconds": 2 }
    }
  }
}
